{
  "name": "atry-turnos",
  "version": "1.2.0",
  "private": true,
  "type": "commonjs",
  "description": "Atry Turnos — plataforma web multiempresa de reservas (preview funcional)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/*.test.js",
