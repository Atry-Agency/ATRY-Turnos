# Documentation only. PLACEHOLDERS, not a dotenv file to source or deploy wholesale.
# Frontend public configuration (generated runtime-config.js)
PUBLIC_SUPABASE_URL=https://STAGING_REF.supabase.co
PUBLIC_SUPABASE_KEY=STAGING_PUBLISHABLE_KEY
PUBLIC_TURNSTILE_SITE_KEY=STAGING_WIDGET_SITE_KEY
CLOUD_BACKEND_VALIDATED=0
PUBLIC_PA_REGISTRATION_ENABLED=0
REGIONAL_BACKEND_VALIDATED=0
PA_RELEASE_APPROVED=0
# Edge secrets in staging only (SUPABASE_* supplied by its own runtime)
PUBLIC_URL=https://STAGING_SITE.pages.dev
PUBLIC_ABUSE_PROTECTION=turnstile
TURNSTILE_SECRET_KEY=STAGING_WIDGET_SECRET
MAIL_DELIVERY_ENABLED=0
BREVO_EVENTS_ENABLED=0
BREVO_SENDER_VERIFIED=0
# Do not set BREVO_API_KEY, MAIL_INVOKE_KEY, BREVO_EVENTS_TOKEN or SMTP yet.
# Later mail trial needs separate authorization and staging-only credentials.
# Read-only runner only after signed scope / explicit authorization
ATRY_STAGING_PUBLISHABLE_KEY=STAGING_PUBLISHABLE_KEY
ATRY_STAGING_OWNER_A_TOKEN=STAGING_NORMAL_SESSION_ONLY
ATRY_STAGING_OWNER_B_TOKEN=STAGING_NORMAL_SESSION_ONLY
