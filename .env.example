PORT=3300
HOST=127.0.0.1
DB_FILE=./data/atry-turnos.sqlite
# En producción configura HTTPS inverso y la variable PUBLIC_URL.
PUBLIC_URL=http://localhost:3300
# Solo para el entorno local: SEED_DEMO=1 habilita datos de ejemplo
SEED_DEMO=0
NODE_ENV=development
MAIL_PROVIDER=local
MAIL_LOCAL_DIR=./data/mail
MAIL_WORKER=1
MAIL_INTERVAL_MS=5000
MAIL_FROM=Atry Turnos <turnos@example.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=0
SMTP_REQUIRE_TLS=1
